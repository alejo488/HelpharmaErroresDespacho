<form asp-action="CargarSoportes"
      asp-controller="Home"
      method="post"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label class="form-label">Archivo Excel (.xlsx)</label>
        <input type="file"
               name="archivoExcel"
               class="form-control"
               accept=".xlsx"
               required />
    </div>

    <button type="submit" class="btn btn-primary">
        Cargar Excel
    </button>
</form>

